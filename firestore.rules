rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Nguồn sự thật (source of truth) cho admin bootstrap ===
    // Sửa giá trị này khi đổi ADMIN_EMAIL, rồi deploy lại:
    //   firebase deploy --only firestore:rules
    function bootstrapAdminEmail() {
      return "heosat0710@gmail.com"; // <-- thay bằng email admin thật
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Email đã được Google xác thực trong ID token — client KHÔNG thể giả mạo.
    function authEmail() {
      return request.auth.token.email;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && authEmail() == bootstrapAdminEmail();
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin bootstrap luôn được coi là ACTIVE, kể cả khi collection users
    // chưa có document nào (chưa kịp ensureProfile()).
    function isActive() {
      return isSignedIn()
        && (
          isBootstrapAdmin()
          || (userExists() && userDoc().status == 'ACTIVE')
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isBootstrapAdmin()
          || (userExists() && userDoc().status == 'ACTIVE' && userDoc().role == 'ADMIN')
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.googleUid == request.auth.uid
        // email lưu trong doc PHẢI khớp email đã xác thực của token, không tin client
        && request.resource.data.email == authEmail()
        && (
          (isBootstrapAdmin()
            && request.resource.data.role == 'ADMIN'
            && request.resource.data.status == 'ACTIVE')
          || (!isBootstrapAdmin()
            && request.resource.data.role == 'USER'
            && request.resource.data.status == 'PENDING')
        );

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status)
        // Tự "chữa lành": nếu email là admin bootstrap, luôn được phép tự sửa
        // lại role/status về ADMIN/ACTIVE (phòng trường hợp doc cũ bị sai do bug).
        || (isBootstrapAdmin() && request.auth.uid == userId
            && request.resource.data.role == 'ADMIN'
            && request.resource.data.status == 'ACTIVE');

      allow delete: if isAdmin();
    }

    match /people/{personId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive();
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update: if isActive();
      allow delete: if false;

      match /history/{historyId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.changedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}